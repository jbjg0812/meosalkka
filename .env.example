# SQLite DB 파일 위치 (prisma/ 기준 상대경로)
DATABASE_URL="file:./dev.db"

# 최초 관리자 계정 (seed 시 생성, 첫 로그인 때 비밀번호 변경 강제)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="ChangeMe!2026"

# HTTPS로 운영할 때만 true (http에서 true면 로그인 쿠키가 저장되지 않음)
COOKIE_SECURE="false"

# 업로드 파일 저장 경로 (기본: 프로젝트/uploads)
UPLOAD_DIR="./uploads"

# 서명용 비밀키 (접수 조회 쿠키, 신청 폼 토큰). 운영 시 반드시 임의의 긴 문자열로 변경
#   생성 예: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=""

# 운영 서버 포트/주소 (npm start)
PORT=3000
HOST="0.0.0.0"

# nginx 등 리버스 프록시 뒤에서 운영할 때만 true
# (프록시는 X-Forwarded-For를 실제 접속 IP로 '덮어쓰도록' 설정해야 함)
TRUST_PROXY="false"
